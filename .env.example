# Copie para .env.local (que nao vai para o repositorio) e preencha.

# Opcional. Troca o destino do lead (POST JSON), por exemplo para um webhook de
# teste. Sem ela: em producao vai para o webhook de src/lib/site.ts; em
# desenvolvimento (npm run dev) nao vai para lugar nenhum e o formulario mostra
# a falha, para ninguem criar lead de teste no Kommo sem querer.
LEAD_WEBHOOK_URL=

# Opcional: enviado como "Authorization: Bearer ...". E a senha que protege o
# webhook do n8n (autenticacao por cabecalho).
LEAD_WEBHOOK_TOKEN=
