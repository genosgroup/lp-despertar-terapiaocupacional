# Copie para .env.local (que nao vai para o repositorio) e preencha.

# Para onde o lead do formulario vai (POST JSON). Sem isto, o formulario mostra a
# mensagem de falha com o WhatsApp e nao conta conversao.
LEAD_WEBHOOK_URL=

# Opcional: enviado como "Authorization: Bearer ...".
LEAD_WEBHOOK_TOKEN=
